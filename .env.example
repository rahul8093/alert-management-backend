# ---------- API ----------
PORT=4000
CORS_ORIGIN=*

# ---------- MySQL ----------
# One MySQL login is used. It needs SELECT on SRC_DB and full access on APP_DB.
# Best practice: give this login ONLY "SELECT" on SRC_DB so the real data can never be changed.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=

# Existing database (READ ONLY - this app never writes to it)
SRC_DB=ptechview_cpcb
# New database owned by this app (alerts, tokens, notification queue)
APP_DB=alert_app

# Timezone the data in tt_raw_device.log_date is stored in (IST)
DATA_TZ_OFFSET=+05:30

# ---------- Auth ----------
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
# How m_user.password is stored: auto | sha256 | sha1 | md5 | plain
PASSWORD_HASH=auto
# m_role ids that can see all plants and close alerts (1=Admin, 3=Super User)
ADMIN_ROLE_IDS=1,3

# ---------- Alert worker ----------
WORKER_INTERVAL_SECONDS=60
# Device is "offline" when no reading arrived for this many minutes
OFFLINE_AFTER_MINUTES=120
# Warning when value >= max_setpoint * WARN_RATIO
WARN_RATIO=0.9
# Ignore readings older than this when checking limits (minutes)
ALERT_MAX_AGE_MINUTES=120

# ---------- Notifications (leave empty to disable) ----------
DISPATCH_INTERVAL_SECONDS=10
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Alert Manager <alerts@example.com>
# Extra emails that get every alert (comma separated)
ALERT_EMAILS=
# Path to Firebase service-account JSON for push notifications
FIREBASE_SERVICE_ACCOUNT=

# ---------- "Contact administrator" screen in the app ----------
CONTACT_NAME=System Administrator
CONTACT_TEAM=Prashitech Solutions support
CONTACT_EMAIL=
CONTACT_PHONE=
